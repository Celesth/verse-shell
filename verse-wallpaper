#!/usr/bin/env bash
# verse-wallpaper — set wallpaper via awww (images / animated gifs) or mpvpaper
# (video). Called by verse with: WALL=<path> BLUR=<path> wallCommand="verse-wallpaper"

set -euo pipefail

WALL="${WALL:?WALL not set}"
BLUR="${BLUR:-}"
MONITOR="${VERSE_MONITOR:-$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].name' 2>/dev/null || echo "VGA-1")}"

# expand ~ in paths
WALL="${WALL/#\~/$HOME}"
BLUR="${BLUR/#\~/$HOME}"

# the outputs the wallpaper lands on — every connected monitor, so each one
# gets the same image instead of only the first
outputs() {
    hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null \
        | grep -v '^$' || echo "$MONITOR"
}
OUTPUTS="$(outputs | paste -sd, -)"
OUTPUTS="${OUTPUTS:-$MONITOR}"

# map the user's fit setting (Settings.wallpaperFit) to awww's --resize:
# crop fills the screen cropping overflow, fit shows the whole image
# letterboxed, center/original draw at native size, padded with the fill color
fit_mode() {
    case "${1:-crop}" in
        fit) echo fit ;;
        center|original) echo no ;;
        *) echo crop ;;
    esac
}

# awww is a layer-shell daemon: make sure it is up before sending it an image,
# starting it ourselves if the compositor hasn't already
ensure_awww() {
    if awww query >/dev/null 2>&1; then return 0; fi
    if ! command -v awww-daemon >/dev/null 2>&1; then return 1; fi
    setsid awww-daemon >/dev/null 2>&1 &
    for _ in $(seq 1 20); do
        sleep 0.1
        awww query >/dev/null 2>&1 && return 0
    done
    return 1
}

# determine file type
ext="${WALL##*.}"
ext="${ext,,}"

case "$ext" in
    mp4|webm|mkv|mov)
        # awww only renders images and animated gifs; videos stay on mpvpaper
        pkill mpvpaper 2>/dev/null || true
        awww clear >/dev/null 2>&1 || true
        sleep 0.1
        setsid mpvpaper -s -a MAX -o "no-audio --loop-file=inf" "$MONITOR" "$WALL" >/dev/null 2>&1 &
        ;;
    *)
        pkill mpvpaper 2>/dev/null || true
        if ! ensure_awww; then
            echo "verse-wallpaper: awww-daemon unavailable" >&2
            exit 1
        fi
        FIT="$(fit_mode "$(jq -r '.wallpaperFit // "crop"' \
            "$HOME/.config/verse/settings.json" 2>/dev/null)")"
        awww img --outputs "$OUTPUTS" --resize "$FIT" \
            --transition-type none "$WALL" >/dev/null 2>&1 || exit 1
        ;;
esac

# generate matugen color scheme from the wallpaper — updates kitty, hyprland,
# gtk, fuzzel, and any other template in ~/.config/matugen/config.toml
if command -v matugen >/dev/null 2>&1; then
    matugen image "$WALL" --json hex --prefer saturation >/dev/null 2>&1 || true
fi